---
interface Props {
  placement: 'top_300x250' | 'sticky_320x50' | 'native' | 'infeed';
}
const { placement } = Astro.props;
const dimensions = {
  top_300x250: [300, 250], sticky_320x50: [320, 50],
  native: [300, 250], infeed: [300, 250],
}[placement];
---
<aside class:list={['ad-slot', { 'ad-sticky': placement === 'sticky_320x50' }]}
  style={`--ad-width:${dimensions[0]}px;--ad-height:${dimensions[1]}px`}
  aria-label="Advertisement placeholder" data-placement={placement}>
  <span>Advertisement · placeholder</span>
</aside>
