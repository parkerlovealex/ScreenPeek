---
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import PosterCard from './PosterCard.astro';
import type { TrailerPageData } from '../lib/trailer';
import { mediaUrl } from '../lib/media';
import { siteOrigin, trailerSchema } from '../lib/seo';
import { env } from 'cloudflare:workers';
interface Props { data: TrailerPageData; mediaBase?: string; }
const { data, mediaBase } = Astro.props;
const { title } = data;
const available = data.status === 200 && title !== null;
const key = typeof data.key === 'string' && /^[A-Za-z0-9_-]{11}$/.test(data.key) ? data.key : null;
const poster = mediaUrl(title?.poster_r2, mediaBase, 185);
const detailUrl = `/${title?.type === 'tv' ? 'tv' : 'movie'}/${encodeURIComponent(title?.slug || '')}/`;
const pageTitle = available ? `${title!.title}${title!.year ? ` (${title!.year})` : ''} Trailer — Details & Where to Watch` :
  data.status === 410 ? 'Title removed' : data.status === 503 ? 'Trailer unavailable' : 'Title not found';
const errorHeading = data.status === 410 ? 'This title has been removed.' : data.status === 503 ? 'Trailer details are temporarily unavailable.' : 'This title could not be found.';
const overview = title?.overview?.trim() || '';
---
<Base title={pageTitle} description={available && overview ? overview.slice(0, 155) : undefined}
  sample={data.sample} noindex={data.noindex} pageType={available ? 'trailer' : 'utility'} schemas={trailerSchema(data, siteOrigin(env.SITE_URL), mediaBase)} ogImage={available ? poster : null}>
  {!available || !title ? <section class="empty-state"><p class="eyebrow">{data.status === 503 ? 'CATALOGUE' : `${data.status} · ${data.status === 410 ? 'REMOVED' : 'NOT FOUND'}`}</p><h1>{errorHeading}</h1><p>{data.status === 503 ? 'Please try again shortly.' : 'Explore the catalogue to find another movie or series.'}</p><a class="button primary" href="/">Go home</a></section> : <article data-trailer-page>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={title.type === 'tv' ? '/series/' : '/movies/'}>{title.type === 'tv' ? 'Series' : 'Movies'}</a><span aria-hidden="true">/</span><a href={detailUrl}>{title.title}</a><span aria-hidden="true">/</span><span aria-current="page">Trailer</span></nav>
    <header class="page-heading"><p class="eyebrow">TRAILER</p><h1>{title.title} trailer</h1><p>{title.year ?? 'Year TBA'} · {title.type === 'tv' ? 'TV series' : 'Movie'}</p></header>
    {key ? <>
      <div class:list={['trailer-facade', { 'has-poster': Boolean(poster) }]} data-trailer-facade data-trailer-key={key}>
        {poster && <img src={poster} width="185" height="278" loading="eager" fetchpriority="high" decoding="async" alt={`${title.title} poster`} />}
        <div class="trailer-facade-copy"><span class="eyebrow">YOUTUBE</span><a class="button primary" data-load-trailer data-trailer-title={`${title.title} trailer from YouTube`} href={`https://www.youtube.com/watch?v=${encodeURIComponent(key)}`} target="_blank" rel="noopener noreferrer">Load trailer from YouTube</a><small>Loads an external video when selected.</small></div>
      </div>
      <script is:inline>
        document.querySelectorAll('[data-trailer-facade]').forEach(f=>{
          const a=f.querySelector('a');
          a?.addEventListener('click',e=>{
            if(e.button||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;
            const k=f.getAttribute('data-trailer-key');
            if(!/^[A-Za-z0-9_-]{11}$/.test(k||''))return;
            e.preventDefault();
            const i=document.createElement('iframe');
            i.src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(k||'')+'?autoplay=1&rel=0';
            i.title=a.getAttribute('data-trailer-title')||'Trailer from YouTube';i.width='560';i.height='315';
            i.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';i.allowFullscreen=true;i.referrerPolicy='strict-origin-when-cross-origin';
            f.replaceChildren(i);
          });
        });
      </script>
    </> : <section class="trailer-unavailable"><h2>No trailer is available yet.</h2><p>Explore the title’s details, cast and legal watch options below.</p></section>}
    <AdSlot pageType="trailer" placement="top_300x250" />
    <section class="catalogue-section storyline"><h2>About {title.title}</h2><p>{overview ? `${overview.slice(0, 360)}${overview.length > 360 ? '…' : ''}` : 'A summary is not available yet.'}</p><div class="detail-actions"><a class="button" href={detailUrl}>Full title details</a><a class="button primary" href={`/watch/${encodeURIComponent(title.slug)}/`}>Where to Watch →</a></div></section>
    <section class="catalogue-section" aria-labelledby="trailer-similar-title"><h2 id="trailer-similar-title">More Like This</h2>{data.similar.length > 0 ? <div class="poster-grid">{data.similar.slice(0, 12).map(similar => <PosterCard title={similar} mediaBase={mediaBase} />)}</div> : <p class="quiet-empty">Similar titles will appear as the catalogue grows.</p>}</section>
  </article>}
</Base>
