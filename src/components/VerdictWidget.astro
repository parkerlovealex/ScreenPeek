---
import type { TitlePageData } from '../lib/detail';
interface Props { votes: TitlePageData['votes']; titleId: number; titleType: 'movie' | 'tv'; }
const { votes, titleId, titleType } = Astro.props;
const choices = [{ value: 'must', label: 'Must Watch' }, { value: 'good', label: 'Good' },
  { value: 'average', label: 'Average' }, { value: 'skip', label: 'Skip' }];
const countFor = (choice: string) => Math.max(0, votes.find(vote => vote.choice === choice)?.count || 0);
const total = choices.reduce((sum, choice) => sum + countFor(choice.value), 0);
---
<section class="catalogue-section verdict-widget" aria-labelledby="verdict-title" data-detail-section="verdict"
  data-verdict-widget data-title-id={titleId} data-title-type={titleType}>
  <div class="section-heading"><h2 id="verdict-title">Community Verdict</h2><span class="verdict-total" data-verdict-total>≈ {total.toLocaleString('en')} votes</span></div>
  <p class="control-preview" id="verdict-status" data-vote-status role="status">Enable JavaScript and browser storage to vote. Community totals are approximate.</p>
  <div class="verdict-options">{choices.map(choice => {
    const count = countFor(choice.value);
    const percentage = total ? Math.round(count / total * 100) : 0;
    return <div class="verdict-option"><button type="button" disabled data-choice={choice.value} aria-describedby="verdict-status"><span>{choice.label}</span><strong>{percentage}%</strong></button>
      <div class="verdict-track" aria-hidden="true"><span style={`width:${percentage}%`}></span></div><small>≈ {count.toLocaleString('en')} votes</small></div>;
  })}</div>
</section>
<script>import '../scripts/verdict';</script>
