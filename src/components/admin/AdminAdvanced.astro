---
import { env } from 'cloudflare:workers';
import { advancedData } from '../../lib/admin/advanced';
import { permitted } from '../../lib/admin/access';
import type { AdminIdentity, AdminModule } from '../../lib/admin/access';
interface Props { module: AdminModule; actor: AdminIdentity; }
const { module, actor } = Astro.props;
const data = await advancedData(env, actor, module, Astro.url);
const write = permitted(actor, module, true);
const repository = /^[\w.-]+\/[\w.-]+$/.test(env.GITHUB_REPO || '') ? env.GITHUB_REPO : 'parkerlovealex/ScreenPeek';
---
{module === 'dashboard' && <section class="catalogue-section"><h2>Delivery and free limits</h2>{actor.role === 'owner' && <form method="post"><input type="hidden" name="action" value="retry-delivery" /><button>Retry pending propagation and purge</button></form>}<p>Worker requests today: unavailable / 100,000 free daily allowance. D1 rows read today: unavailable / 5,000,000. Live analytics are not configured; no measured usage is implied.</p><a href="https://dash.cloudflare.com/">Open Cloudflare usage</a><p><a href="https://search.google.com/search-console">Search Console</a> · <a href={`https://github.com/${repository}/actions/workflows/ci.yml`}>Latest CI speed and Lighthouse reports</a></p></section>}
{module === 'seo' && <>
  <section class="catalogue-section"><h2>Redirects (301)</h2><form class="admin-search" method="get"><label>Search paths<input name="q" value={data.q} /></label><button>Search</button></form><form class="admin-form" method="post"><input type="hidden" name="action" value="save-redirect" /><fieldset disabled={!write}><label>From path<input name="from_path" value={Astro.url.searchParams.get('path') || ''} placeholder="/old-title/" required maxlength="250" /></label><label>To owned path<input name="to_target" placeholder="/movies/" required maxlength="2048" /></label><button>Save redirect</button></fieldset></form><p>Existing static URLs apply redirects on the next build. Redirect loops and privileged routes are rejected.</p><ul>{data.redirects.map(row => <li>{row.from_path} → {row.to_target}</li>)}</ul></section>
  <section class="catalogue-section"><h2>Title / noindex overrides</h2><form class="admin-form" method="post"><input type="hidden" name="action" value="save-override" /><fieldset disabled={!write}><label>Owned path<input name="path" required placeholder="/movie/title/" maxlength="250" /></label><label>Title override<input name="title" maxlength="200" /></label><label class="admin-check"><input type="checkbox" name="noindex" value="1" /> Noindex</label><button>Save metadata override</button></fieldset></form><p>Overrides cannot make ungated titles or previews indexable. Empty title restores the default template.</p><ul>{data.overrides.map(row => <li>{row.path} · {row.title || 'Default title'} · {row.noindex ? 'Noindex' : 'Default indexing'}</li>)}</ul></section>
  <section class="catalogue-section"><h2>Search engine verification</h2>{data.settings.map(row => <form class="admin-form" method="post"><input type="hidden" name="action" value="save-verification" /><input type="hidden" name="key" value={String(row.key)} /><fieldset disabled={!write}><label>{row.key}<input name="value" value={String(row.value || '')} maxlength="250" /></label><button>Save verification value</button></fieldset></form>)}<p><a href="/sitemap.xml">Sitemap index</a> · <a href="https://search.google.com/search-console">Open Search Console</a></p></section>
  <section class="catalogue-section"><h2>Visited 404 paths</h2><p>Counts are approximate and batched. Query strings and unbounded paths are not stored.</p><ul>{data.missing.map(row => <li>{row.path} · ≈ {row.count} · <a href={`?path=${encodeURIComponent(String(row.path))}`}>Create redirect</a></li>)}</ul></section>
</>}
{(module === 'changes' || module === 'dashboard') && <section class="catalogue-section"><h2>Change history and Undo</h2><p><a href="/admin/changes/?list=admin_trash">Open global Trash</a></p>{module === 'changes' && <form class="admin-search" method="get"><label>Actor<input name="actor" value={Astro.url.searchParams.get('actor') || ''} /></label><label>Entity<input name="entity" value={Astro.url.searchParams.get('entity') || ''} /></label><button>Filter history</button></form>}<div class="admin-table"><table><thead><tr><th>Actor / time</th><th>Item</th><th>Before / after</th><th>Undo</th></tr></thead><tbody>{data.history.slice(0, module === 'dashboard' ? 20 : 50).map(row => <tr><td>{row.actor}<small>{row.ts}</small></td><td>{row.entity} · {row.entity_id}</td><td><details><summary>View change</summary><pre>{row.before || 'New item'}</pre><pre>{row.after}</pre></details></td><td>{(['link','ad_slot','config','page','title','person','content'].includes(String(row.entity)) || String(row.entity).startsWith('bulk:')) && <form method="post" action="/admin/changes/"><input type="hidden" name="action" value="undo" /><input type="hidden" name="log_id" value={String(row.id)} /><button disabled={!permitted(actor, 'changes', true)}>Undo</button></form>}</td></tr>)}</tbody></table></div>{module === 'changes' && <nav class="pagination" aria-label="Change history pages">{data.page > 1 && <a href={`?page=${data.page-1}&actor=${encodeURIComponent(Astro.url.searchParams.get('actor') || '')}&entity=${encodeURIComponent(Astro.url.searchParams.get('entity') || '')}`}>Previous</a>}<span>Page {data.page}</span>{data.history.length === 50 && <a href={`?page=${data.page+1}&actor=${encodeURIComponent(Astro.url.searchParams.get('actor') || '')}&entity=${encodeURIComponent(Astro.url.searchParams.get('entity') || '')}`}>Next</a>}</nav>}</section>}
