---
import { env } from 'cloudflare:workers';
import { permitted } from '../../lib/admin/access';
import { healthReport } from '../../lib/admin/health';
import type { AdminIdentity } from '../../lib/admin/access';
interface Props { actor:AdminIdentity; }
const {actor}=Astro.props;const all=await healthReport(env,actor);const issues=Astro.url.searchParams.get('show_snoozed')==='1'?all:all.filter(row=>!row.snoozed_until);
const page=Math.max(1,Math.min(10000,Number.parseInt(Astro.url.searchParams.get('issues_page')||'1')||1));
---
<section class="catalogue-section" aria-label="Not-working report"><h2>Not-working report</h2><p>{issues.length} current issues. Checks clear automatically after the underlying problem is repaired. Sample data and unset ad codes can produce expected warnings during local setup.</p><p><a href="?show_snoozed=1">Include snoozed issues</a></p><div class="admin-table"><table><thead><tr><th>Severity</th><th>Problem</th><th>Fix / status</th></tr></thead><tbody>{issues.slice((page-1)*50,page*50).map(issue=><tr><td>{issue.severity}</td><td>{issue.message}</td><td><a href={issue.fix}>Fix</a><p>{issue.snoozed_until?'Snoozed':'Open'}</p>{permitted(actor,'dashboard',true)&&<form method="post"><input type="hidden" name="issue_key" value={issue.key} /><input type="hidden" name="action" value={issue.snoozed_until?'reopen-issue':'snooze-issue'} /><button>{issue.snoozed_until?'Reopen':'Snooze 24 hours'}</button></form>}</td></tr>)}</tbody></table></div><nav class="pagination" aria-label="Issue pages">{page>1&&<a href={`?issues_page=${page-1}`}>Previous issues</a>}<span>Page {page}</span>{page*50<issues.length&&<a href={`?issues_page=${page+1}`}>Next issues</a>}</nav></section>
