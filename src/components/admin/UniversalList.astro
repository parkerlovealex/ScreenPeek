---
import MetadataEditor from './MetadataEditor.astro';
import { env } from 'cloudflare:workers';
import { listData, lists, listDefaults, rowKey } from '../../lib/admin/universal';
import { permitted } from '../../lib/admin/access';
import type { AdminIdentity, AdminModule } from '../../lib/admin/access';
import { dhakaInput } from '../../lib/admin/actions';
interface Props { actor: AdminIdentity; module: AdminModule; }
const { actor,module } = Astro.props;
const name=Astro.url.searchParams.get('list') || listDefaults[module] || '';
const data = name ? await listData(env,actor,name,Astro.url) : null;
const href = (params:Record<string,string>) => {const query=new URLSearchParams(Astro.url.searchParams);for(const [key,value]of Object.entries(params))query.set(key,value);return `${Astro.url.pathname}?${query}`;};
const canWrite = data && permitted(actor,data.spec.module,true);
const controls = Object.entries(lists).filter(([,spec])=>spec.module===module||(module==='titles'&&spec.table==='titles'));
---
{data && <section class="catalogue-section" aria-label="Record list controls"><h2>Record list controls</h2>
<nav class="hub-navigation" aria-label="Record lists">{controls.map(([key])=><a href={href({list:key,upage:'1'})}>{key.replaceAll('_',' ')}</a>)}</nav>
<form class="admin-search" method="get"><input type="hidden" name="list" value={name} /><label>Search records<input name="uq" value={data.query} maxlength="100" /></label><label>Sort records<select name="usort">{data.spec.sort.map(field=><option value={field} selected={data.sort===field}>{field}</option>)}</select></label><label>Direction<select name="udir"><option value="asc" selected={!data.desc}>Ascending</option><option value="desc" selected={data.desc}>Descending</option></select></label>{data.spec.trash&&<label>Record state<select name="ustate">{['active','trash','all'].map(state=><option value={state} selected={data.state===state}>{state}</option>)}</select></label>}{data.spec.fields.some(key=>['enabled','hidden','pinned'].includes(key))&&<label>Flag filter<select name="uflag"><option value="">Any</option><option value="1" selected={Astro.url.searchParams.get('uflag')==='1'}>On</option><option value="0" selected={Astro.url.searchParams.get('uflag')==='0'}>Off</option></select></label>}<button>Apply record filters</button></form>
{data.spec.add && <a class="button" href={href({u_edit:'new'})}>Add record</a>}
{['titles','people'].includes(name)&&permitted(actor,name==='people'?'people':'titles')&&<MetadataEditor actor={actor} kind={name==='people'?'person':'title'} record={data.selected} used={data.used} />}
<p>{data.total} records · 50 per page · <a href={href({ucsv:'1'})}>Export filtered CSV (Owner/Editor)</a></p>
<form method="post"><input type="hidden" name="list" value={name} /><fieldset disabled={!canWrite}><div class="admin-table"><table><thead><tr><th>Select</th><th>Item / edit</th><th>State / stats</th></tr></thead><tbody>{data.rows.map(row=><tr><td><input type="checkbox" name="u_keys" value={rowKey(data.spec,row)} aria-label={`Select ${String(row.title||row.name||row.label||row.slug||row.path||row.id||row.key||row.from_path||row.page_type)}`} /></td><td><a href={href({u_edit:rowKey(data.spec,row)})}>{String(row.title||row.name||row.label||row.slug||row.path||row.id||row.key||row.from_path||row.page_type)} {row.placement||''}</a></td><td>{row.deleted?'Permanently removed':row.deleted_at?'Trash':Object.hasOwn(row,'enabled')?row.enabled?'On':'Off':'Active'}{Object.hasOwn(row,'views')&&<> · ≈ {row.views} views</>}{Object.hasOwn(row,'clicks_total')&&<> · ≈ {row.clicks_total} clicks</>}</td></tr>)}</tbody></table></div>
<p>Apply to at most five selected records per request.</p><label>Bulk field<select name="u_field">{data.spec.fields.filter(field=>!['name','label','intro','display_name','pins','destination'].includes(field)).map(field=><option>{field}</option>)}</select></label><label>Bulk value<input name="u_value" maxlength="250" /></label><label class="admin-check"><input type="checkbox" name="confirm_used" value="1" /> Confirm deletion of referenced items after reviewing their “used in” count</label>
{data.spec.fields.length>0&&<button name="u_action" value="bulk">Apply bulk value</button>}{data.spec.trash&&<><button name="u_action" value="trash">Move selected to Trash</button><button name="u_action" value="restore">Restore selected</button>{actor.role==='owner'&&<button name="u_action" value="purge">Permanently purge selected Trash</button>}</>}</fieldset></form>
{Astro.url.searchParams.get('u_edit')==='new' && data.spec.add && <form class="admin-form" method="post"><input type="hidden" name="list" value={name} /><input type="hidden" name="u_action" value="add" /><fieldset disabled={!canWrite}>{[...data.spec.keys,...data.spec.fields].map(field=><label>{field.replaceAll('_',' ')}<input name={`u_${field}`} value={field==='ord'||field==='hidden'?'0':field==='enabled'?'1':field==='source'?'auto':''} /></label>)}<button>Add record</button></fieldset></form>}
{data.selected&&<section><h3>Edit selected record</h3><p>Used in {data.used} places. Trash lasts 30 days. Schedules on static pages take effect on the next build.</p>{data.spec.fields.length>0&&<form class="admin-form" method="post"><input type="hidden" name="list" value={name} /><input type="hidden" name="u_action" value="save" /><input type="hidden" name="u_key" value={rowKey(data.spec,data.selected)} /><input type="hidden" name="u_revision" value={Number(data.selected.revision)} /><fieldset disabled={!canWrite}>{data.spec.fields.map(field=><label>{field.replaceAll('_',' ')}{field==='pins'?<textarea name={`u_${field}`}>{(()=>{try{return JSON.parse(String(data.selected?.[field]||'[]')).join(', ')}catch{return ''}})()}</textarea>:['intro','body_md'].includes(field)?<textarea name={`u_${field}`} maxlength={field==='body_md'?20000:2000}>{String(data.selected?.[field]||'')}</textarea>:<input name={`u_${field}`} type={/ends_at$|starts_at$/.test(field)?'datetime-local':'text'} value={/ends_at$|starts_at$/.test(field)?dhakaInput(String(data.selected?.[field]||'')):String(data.selected?.[field]??'')} />}</label>)}{name==='collections'&&<label>Collection titles<textarea name="u_members">{data.collectionPins}</textarea></label>}<small>Dates use Bangladesh time. Pins use comma-separated movie:ID or tv:ID values. Boolean fields use 0 or 1.</small><button>Save selected record</button></fieldset></form>}{name==='collections'&&<p>Members: {data.collectionPins||'None'}</p>}</section>}
{name==='admin_trash'&&<section><h3>Restore or purge Trash</h3>{data.rows.map(row=><form class="admin-form" method="post"><input type="hidden" name="list" value={String(row.entity)} /><input type="hidden" name="u_keys" value={String(row.entity_key)} /><p>{row.entity} · {row.entity_key} · deleted {row.deleted_at}</p><button name="u_action" value="restore" disabled={!canWrite}>Restore item</button>{actor.role==='owner'&&<button name="u_action" value="purge">Permanently purge item</button>}</form>)}</section>}
<nav class="pagination" aria-label="Record list pages">{data.page>1&&<a href={href({upage:String(data.page-1)})}>Previous records</a>}<span>Page {data.page} of {data.pages}</span>{data.page<data.pages&&<a href={href({upage:String(data.page+1)})}>Next records</a>}</nav>
</section>}
