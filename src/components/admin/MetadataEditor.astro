---
import { env } from 'cloudflare:workers';
import { titleFields,personFields } from '../../lib/admin/metadata';
import { permitted } from '../../lib/admin/access';
import type { AdminIdentity } from '../../lib/admin/access';
import type { AdminRow } from '../../lib/admin/advanced';
import { dhakaInput } from '../../lib/admin/actions';
interface Props{actor:AdminIdentity;kind:'title'|'person';record?:AdminRow|null;used?:number;}
const{actor,kind,record,used=0}=Astro.props;const allowed=permitted(actor,kind==='person'?'people':'titles',true);
const fields=kind==='person'?personFields:titleFields;
const label=(field:string)=>({poster_r2:'Poster object key',backdrop_r2:'Backdrop object key',og_r2:'Sharing-card object key',profile_r2:'Portrait object key',vote_average:'TMDb score',vote_count:'TMDb vote count',runtime_min:'Runtime (minutes)',similar_ids:'Similar title IDs',gallery_r2:'Gallery object keys',original_language:'Language code'}[field]||field.replaceAll('_',' '));
const value=(field:string)=>{if(!record)return '';if(['genres','similar_ids','gallery_r2'].includes(field)){try{return JSON.parse(String(record[field]||'[]')).join(', ')}catch{return ''}}if(field.startsWith('pin_'))return dhakaInput(String(record[field]||''));return String(record[field]??'');};
const votes=record&&kind==='title'?(await env.DB.prepare('SELECT COALESCE(SUM(count),0) n FROM votes WHERE title_id=? AND title_type=?').bind(record.id,record.type).first<{n:number}>())?.n||0:0;
---
{allowed&&<section class="catalogue-section"><h2>Import or re-fetch by TMDb ID</h2><form class="admin-form" method="post"><input type="hidden" name="m_action" value="import" /><input type="hidden" name="m_kind" value={kind} /><label>Targeted IDs<input name="ids" required placeholder={kind==='person'?'person:123':'movie:123, tv:456'} maxlength="4000" /></label><p>This requests a GitHub sync job. The website reads its own catalogue; import completion is shown in Sync & Data.</p><button>Request targeted sync</button></form></section>}
{record&&<section class="catalogue-section" aria-label="Metadata editor"><h2>{kind==='person'?'People':'Title'} metadata</h2><p>ID {record.id} · {record.type||'person'} · used in {used} places{kind==='title'&&<> · ≈ {record.views||0} stored views · ≈ {votes} site verdict votes</>}</p><p>Edited fields lock against sync automatically. Provider offers and credits refresh through sync. Static pages and sharing cards refresh through their build/sync jobs.</p><form class="admin-form" method="post"><input type="hidden" name="m_action" value="save" /><input type="hidden" name="m_kind" value={kind} /><input type="hidden" name="id" value={String(record.id)} /><input type="hidden" name="type" value={String(record.type||'movie')} /><input type="hidden" name="m_revision" value={String(record.revision)} /><input type="hidden" name="m_updated_at" value={String(record.updated_at)} /><fieldset disabled={!allowed||!!record.deleted||!!record.deleted_at}>
{fields.map(field=><label>Metadata {label(field)}{['overview','bio'].includes(field)?<textarea name={`m_${field}`} rows="8" maxlength="20000">{value(field)}</textarea>:<input name={`m_${field}`} type={field==='release_date'?'date':field.startsWith('pin_')?'datetime-local':'text'} value={value(field)} maxlength="20000" />}</label>)}
<p>Locked fields: {String(record.locked_fields||'[]')}</p><label>Fields to unlock<input name="unlock_fields" placeholder="overview, runtime_min" /></label><label class="admin-check"><input type="checkbox" name="clear_locks" value="1" /> Clear existing locks (new edits still lock)</label><button>Save metadata</button></fieldset></form>
{allowed&&kind==='title'&&!record.deleted&&<form method="post"><input type="hidden" name="m_action" value="reset-votes" /><input type="hidden" name="m_kind" value="title" /><input type="hidden" name="id" value={String(record.id)} /><input type="hidden" name="type" value={String(record.type)} /><input type="hidden" name="m_revision" value={String(record.revision)} /><input type="hidden" name="m_updated_at" value={String(record.updated_at)} /><p>Reset aggregate verdict counts. Daily voting limits still apply.</p><button>Reset aggregate votes</button></form>}
{allowed&&actor.role==='owner'&&!record.deleted&&<details><summary>Permanent deletion</summary><form class="admin-form" method="post"><input type="hidden" name="m_action" value="delete" /><input type="hidden" name="m_kind" value={kind} /><input type="hidden" name="id" value={String(record.id)} /><input type="hidden" name="type" value={String(record.type||'movie')} /><input type="hidden" name="m_revision" value={String(record.revision)} /><input type="hidden" name="m_updated_at" value={String(record.updated_at)} /><label>Type DELETE to permanently remove<input name="confirm_delete" required pattern="DELETE" /></label><label class="admin-check"><input type="checkbox" name="confirm_used" value="1" /> Confirm removal from the {used} referenced places</label><p>Titles return 410 after static refresh. A never-import entry prevents sync resurrection.</p><button>Permanently delete record</button></form></details>}
</section>}
