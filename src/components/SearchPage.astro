---
import Base from '../layouts/Base.astro';
import PosterCard from './PosterCard.astro';
import Pagination from './Pagination.astro';
import AdSlot from './AdSlot.astro';
import type { SearchPageData } from '../lib/search';
import { itemListSchema, siteOrigin } from '../lib/seo';
import { env } from 'cloudflare:workers';
interface Props { data: SearchPageData; mediaBase?: string; }
const { data, mediaBase } = Astro.props;
const { filters, catalogue, options } = data;
const available = data.status === 200;
const searching = data.query.length >= 2;
const pageTitle = data.status === 503 ? 'Search unavailable' : data.status === 400 ? 'Invalid search' : data.status === 404 ? 'Results page not found' :
  `${data.query ? `Search: ${data.query}` : 'Search movies & series'}${catalogue.page > 1 ? ` — Page ${catalogue.page}` : ''}`;
const firstPage = new URLSearchParams(Astro.url.searchParams);
firstPage.delete('page');
const ratings = [...new Set([6, 7, 8, 9, ...(filters.minRating === undefined ? [] : [filters.minRating])])].sort((a, b) => a - b);
---
<Base title={pageTitle} description="Search the movie and TV catalogue by title, genre, year and TMDb rating."
  sample={data.sample} noindex={true} pageType={available ? 'search' : 'utility'} schemas={available && catalogue.titles.length ? [itemListSchema(catalogue.titles, siteOrigin(env.SITE_URL), catalogue.page)] : []}>
  <article data-search-page>
    <header class="page-heading"><a class="back-link" href="/">← Home</a><h1>Search movies & series</h1><p>Find a title, then explore its story, cast and watch options.</p></header>
    <form class="catalogue-filters search-filters" action="/search/" method="get" aria-label="Search filters">
      <label class="search-query-field" for="query">Search titles<input id="query" name="q" type="search" value={data.query} placeholder="Movie or series title" maxlength="100" minlength="2" /></label>
      <label for="search-type">Type<select id="search-type" name="type"><option value="">Movies & series</option><option value="movie" selected={filters.type === 'movie'}>Movies</option><option value="tv" selected={filters.type === 'tv'}>Series</option></select></label>
      <label for="search-genre">Genre<select id="search-genre" name="genre"><option value="">All genres</option>{options.genres.map(genre => <option value={genre.slug} selected={filters.genre === genre.slug}>{genre.name}</option>)}</select></label>
      <label for="search-year">Year<select id="search-year" name="year"><option value="">Any year</option>{options.years.map(year => <option value={year} selected={filters.year === year}>{year}</option>)}</select></label>
      <label for="search-rating">TMDb rating<select id="search-rating" name="rating"><option value="">Any rating</option>{ratings.map(value => <option value={value} selected={filters.minRating === value}>{value}+</option>)}</select></label>
      <label for="search-sort">Sort by<select id="search-sort" name="sort"><option value="" selected={!filters.sort}>Relevance</option><option value="popular" selected={filters.sort === 'popular'}>Popular</option><option value="newest" selected={filters.sort === 'newest'}>Recently added</option><option value="rating" selected={filters.sort === 'rating'}>Highest rated</option><option value="release" selected={filters.sort === 'release'}>Release date</option></select></label>
      <div class="filter-actions"><button class="primary" type="submit">Search</button><a href="/search/">Clear</a></div>
    </form>
    {!available ? <section class="empty-state"><h2>{data.status === 503 ? 'Search is temporarily unavailable.' : data.status === 400 ? 'Use a search query of up to 100 characters.' : 'That results page could not be found.'}</h2><p>{data.status === 503 ? 'Please try again shortly.' : 'Adjust your search above or return to the first results page.'}</p>{data.status === 404 && <a class="button" href={`/search/?${firstPage.toString()}`}>First results page</a>}</section> : !searching ?
      <section class="empty-state"><h2>What would you like to find?</h2><p>Enter at least two characters to search movies and series.</p></section> : <>
      <div class="results-heading"><p><strong>{catalogue.total.toLocaleString('en')}</strong> {catalogue.total === 1 ? 'result' : 'results'} for <span class="query-label">“{data.query}”</span></p><p>Page {catalogue.page} of {catalogue.pages}</p></div>
      {catalogue.titles.length ? <><div class="poster-grid" data-catalogue-grid>{catalogue.titles.map((title, index) => <PosterCard title={title} mediaBase={mediaBase} eager={index < 3} />)}<div class="grid-ad"><AdSlot pageType="search" placement="native" /></div></div><Pagination page={catalogue.page} pages={catalogue.pages} url={Astro.url} /></> :
        <section class="empty-state"><h2>No matching titles.</h2><p>Try another title or fewer filters.</p><a class="button" href={`/search/?q=${encodeURIComponent(data.query)}`}>Clear filters</a></section>}
    </>}
  </article>
</Base>
