---
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import { seasonPath, episodePath } from '../lib/seasons';
import type { EpisodePageData } from '../lib/seasons';
import { mediaUrl } from '../lib/media';
import { episodeSchema, siteOrigin } from '../lib/seo';
import { env } from 'cloudflare:workers';
interface Props { data: EpisodePageData; mediaBase?: string; }
const { data, mediaBase } = Astro.props;
const { title, season, episode } = data;
const available = data.status === 200 && title !== null && season !== null && episode !== null;
const episodeName = episode?.name || `Episode ${episode?.episode_number ?? ''}`;
const seriesUrl = `/tv/${encodeURIComponent(title?.slug || '')}/`;
const seasonUrl = title && season ? seasonPath(title.slug, season.season_number) : seriesUrl;
const seasonName = season?.name || `Season ${season?.season_number ?? ''}`;
const pageTitle = available ? `${title!.title} Season ${season!.season_number} Episode ${episode!.episode_number} — ${episodeName}` :
  data.status === 410 ? 'Series removed' : data.status === 503 ? 'Episode unavailable' : 'Episode not found';
const errorHeading = data.status === 410 ? 'This series has been removed.' : data.status === 503 ? 'Episode details are temporarily unavailable.' : 'That episode could not be found.';
const still = mediaUrl(episode?.still_r2, mediaBase, 185);
const airDate = episode?.air_date && Number.isFinite(Date.parse(episode.air_date)) ?
  new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(episode.air_date)) : null;
---
<Base title={pageTitle} description={available && episode?.overview ? episode.overview.slice(0, 155) : undefined}
  sample={data.sample} noindex={data.noindex} pageType={available ? 'list' : 'utility'} schemas={episodeSchema(data, siteOrigin(env.SITE_URL), mediaBase)} ogImage={available ? still : null}>
  {!available || !title || !season || !episode ? <section class="empty-state"><p class="eyebrow">{data.status === 503 ? 'CATALOGUE' : `${data.status} · ${data.status === 410 ? 'REMOVED' : 'NOT FOUND'}`}</p><h1>{errorHeading}</h1><p>{data.status === 503 ? 'Please try again shortly.' : 'Explore the catalogue to find another series.'}</p><a class="button primary" href="/">Go home</a></section> : <article data-episode-page>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/series/">Series</a><span aria-hidden="true">/</span><a href={seriesUrl}>{title.title}</a><span aria-hidden="true">/</span><a href={seasonUrl}>{seasonName}</a><span aria-hidden="true">/</span><span aria-current="page">Episode {episode.episode_number}</span></nav>
    <header class="page-heading"><p class="eyebrow">SEASON {season.season_number} · EPISODE {episode.episode_number}</p><h1>{episodeName}</h1><p><a href={seriesUrl}>{title.title}</a>{airDate ? <> · <time datetime={episode.air_date!}>{airDate}</time></> : ' · Air date to be announced'}</p></header>
    <div class="detail-actions season-actions"><a class="button primary" href={seasonUrl}>All episodes</a><a class="button" href={`/watch/${encodeURIComponent(title.slug)}/`}>Where to Watch →</a><a class="button" href={`/trailer/${encodeURIComponent(title.slug)}/`}>Series trailer</a></div>
    {still && <figure class="episode-feature"><img src={still} width="185" height="104" loading="eager" fetchpriority="high" decoding="async" alt={`${episodeName} still`} /></figure>}
    <section class="catalogue-section storyline"><h2>Episode overview</h2><p>{episode.overview?.trim() || 'An overview is not available yet.'}</p></section>
    <AdSlot pageType="list" placement="native" />
    {(data.previous || data.next) && <nav class="episode-navigation" aria-label="Episode navigation">
      {data.previous && <a href={episodePath(title.slug, season.season_number, data.previous.episode_number)} rel="prev"><small>← Previous episode</small><strong>Episode {data.previous.episode_number}</strong><span>{data.previous.name || 'Episode details'}</span></a>}
      {data.next && <a class="episode-next" href={episodePath(title.slug, season.season_number, data.next.episode_number)} rel="next"><small>Next episode →</small><strong>Episode {data.next.episode_number}</strong><span>{data.next.name || 'Episode details'}</span></a>}
    </nav>}
    <p class="episode-back"><a href={seasonUrl}>← Back to {seasonName}</a><a href={seriesUrl}>Series details →</a></p>
  </article>}
</Base>
