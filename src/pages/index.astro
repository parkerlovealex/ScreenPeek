---
import { homeSections, manualTitles } from '../lib/home-config';
import type { HomeSection } from '../lib/home-config';
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import PosterCard from '../components/PosterCard.astro';
import { env } from 'cloudflare:workers';
import { sampleMode, homeTitles, titleUrl } from '../lib/catalogue';
import { rating } from '../lib/format';
import { itemListSchema, siteOrigin } from '../lib/seo';
let sample = false, failed = false;
let sections:HomeSection[]=[];
let catalogue: Awaited<ReturnType<typeof homeTitles>> = { trending: [], top10: [], movies: [], series: [], upcoming: [], genres: [] };
try { sample = await sampleMode(env.DB); catalogue = await homeTitles(env.DB, sample); sections=await homeSections(env.DB); for(const section of sections) if(section.source==='manual' && ['trending','top10','movies','series','upcoming'].includes(section.key)) catalogue[section.key as 'trending']=await manualTitles(env.DB,section,sample); } catch { failed = true; Astro.response.status = 503; }
Astro.response.headers.set('Cache-Control', sample || failed ? 'no-store' : 'public, s-maxage=3600, stale-while-revalidate=604800');
const categories = [
  { href: '/movies/', name: 'Movies', description: 'Stories for a night in', mark: '01' },
  { href: '/series/', name: 'Series', description: 'Find your next series', mark: '02' },
  { href: '/new/', name: 'New arrivals', description: 'Fresh in the catalogue', mark: '03' },
  { href: '/upcoming/', name: 'Upcoming', description: 'What is coming next', mark: '04' },
];
---
<Base title="Discover movies & TV" sample={sample} noindex={sample || failed} pageType={failed ? 'utility' : 'home'} schemas={failed ? [] : [itemListSchema(catalogue.trending, siteOrigin(env.SITE_URL))]}>
  <section class="intro"><p class="eyebrow">MOVIES & TV, EXPLAINED</p>
    <h1>Your next watch starts here.</h1>
    <p>Explore stories, meet the cast, and find legal ways to watch.</p>
    <form class="hero-search" action="/search/" role="search" aria-label="Find a movie or series"><label class="sr-only" for="home-search">Find a movie or series</label><input id="home-search" type="search" name="q" placeholder="Find a movie or series" maxlength="100" required /><button class="primary" type="submit">Search</button></form>
  </section>
  {failed ? <section class="empty-state"><h2>The catalogue is temporarily unavailable.</h2><p>Please try again shortly.</p></section> : <>
{!sections.some(section=>section.key==='trending')&&<AdSlot pageType="home" placement="top_300x250" />}
{sections.map(section => <>
{section.key === 'trending' && <>    <section class="catalogue-section" aria-labelledby="trending-title"><div class="section-heading"><div><p class="eyebrow">IN THE SPOTLIGHT</p><h2 id="trending-title">{section.label}</h2></div><a class="section-more" href="/top10/">Top 10 →</a></div>
      {catalogue.trending.length ? <div class="poster-row">{catalogue.trending.map((title, index) => <PosterCard title={title} mediaBase={env.R2_PUBLIC_BASE} eager={index < 3 && sections[0]?.key === 'trending'} />)}</div> : <p class="quiet-empty">New titles will appear after the next catalogue update.</p>}
    </section>
    <AdSlot pageType="home" placement="top_300x250" />
</>}
{section.key === 'top10' && <>    <section class="catalogue-section" aria-labelledby="top10-title"><div class="section-heading"><div><p class="eyebrow">THE MOST POPULAR</p><h2 id="top10-title">{section.label}</h2></div><a class="section-more" href="/top10/">See all →</a></div>
      {catalogue.top10.length ? <ol class="ranked-list">{catalogue.top10.map((title, index) => <li><a href={titleUrl(title)}><span class="rank-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="rank-title"><strong>{title.title}</strong><small>{title.year ?? 'Year TBA'} · {title.type === 'movie' ? 'Movie' : 'TV series'}</small></span><span class="rank-score" title="TMDb rating">{rating(title.vote_average)}</span></a></li>)}</ol> : <p class="quiet-empty">The weekly list is waiting for its first titles.</p>}
    </section>
</>}
{section.key === 'movies' && <>    <section class="catalogue-section" aria-labelledby="movies-title"><div class="section-heading"><h2 id="movies-title">{section.label}</h2><a class="section-more" href="/movies/">All movies →</a></div>
      {catalogue.movies.length ? <div class="poster-grid">{catalogue.movies.map(title => <PosterCard title={title} mediaBase={env.R2_PUBLIC_BASE} />)}</div> : <p class="quiet-empty">New movies will appear here.</p>}
    </section>
    <AdSlot pageType="home" placement="native" />
</>}
{section.key === 'series' && <>    <section class="catalogue-section" aria-labelledby="series-title"><div class="section-heading"><h2 id="series-title">{section.label}</h2><a class="section-more" href="/series/">All series →</a></div>
      {catalogue.series.length ? <div class="poster-grid">{catalogue.series.map(title => <PosterCard title={title} mediaBase={env.R2_PUBLIC_BASE} />)}</div> : <p class="quiet-empty">New series will appear here.</p>}
    </section>
</>}
{section.key === 'upcoming' && <>    <section class="catalogue-section" aria-labelledby="upcoming-title"><div class="section-heading"><h2 id="upcoming-title">{section.label}</h2><a class="section-more" href="/upcoming/">Upcoming →</a></div>
      {catalogue.upcoming.length ? <div class="poster-row">{catalogue.upcoming.map(title => <PosterCard title={title} mediaBase={env.R2_PUBLIC_BASE} />)}</div> : <p class="quiet-empty">Upcoming releases will appear after the next catalogue update.</p>}
    </section>
</>}
{section.key === 'categories' && <>    <section class="catalogue-section" aria-labelledby="categories-title"><div class="section-heading"><h2 id="categories-title">{section.label}</h2></div><div class="category-grid">{categories.map(category => <a class="category-tile" href={category.href}><span class="category-number" aria-hidden="true">{category.mark}</span><strong>{category.name}</strong><small>{category.description}</small><span class="category-arrow" aria-hidden="true">↗</span></a>)}</div></section>
</>}
{section.key === 'genres' && <>    {catalogue.genres.length > 0 && <section class="catalogue-section" aria-labelledby="genres-title"><div class="section-heading"><h2 id="genres-title">{section.label}</h2></div><div class="genre-chips">{catalogue.genres.map(genre => <a href={`/genre/${genre.slug}/`}>{genre.name}<span>{genre.title_count}</span></a>)}</div></section>}
</>}
</>)}
{!sections.some(section=>section.key==='movies')&&<AdSlot pageType="home" placement="native" />}
  </>}
</Base>
