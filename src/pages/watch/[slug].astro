---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import ProviderRow from '../../components/ProviderRow.astro';
import { loadWatchPage } from '../../lib/watch';
import { countryCookie, countryNames, supportedCountries } from '../../lib/geo';
import { mediaUrl } from '../../lib/media';
import { breadcrumbs, siteOrigin } from '../../lib/seo';
const data = await loadWatchPage(env.DB, env.CONFIG, Astro.params.slug || '', Astro.request);
Astro.response.status = data.status;
Astro.response.headers.set('Cache-Control', data.cacheControl);
if (data.status === 200) Astro.response.headers.append('Set-Cookie', countryCookie(data.country));
const title = data.title;
const available = data.status === 200 && title;
const name = countryNames[data.country];
const poster = mediaUrl(title?.poster_r2, env.R2_PUBLIC_BASE, 185);
const groups = [{ name: 'Stream', values: ['stream'] }, { name: 'Free', values: ['free','ads'] }, { name: 'Rent', values: ['rent'] }, { name: 'Buy', values: ['buy'] }];
---
<Base title={available ? `Where to Watch ${title.title}${title.year ? ` (${title.year})` : ''} in ${name} — Streaming, Rent & Buy` : 'Watch information unavailable'} description={available ? `See where ${title.title} is available in ${name}, with streaming, rent and buy options.` : undefined} sample={data.sample} noindex={data.noindex} pageType={available ? 'watch' : 'utility'} ogImage={available ? poster : null}
  schemas={available ? [breadcrumbs([{ name: 'Home', path: '/' }, { name: title.title, path: `/${title.type === 'movie' ? 'movie' : 'tv'}/${title.slug}/` }, { name: 'Where to Watch', path: Astro.url.pathname }], siteOrigin(env.SITE_URL))] : []}>
  {!available ? <section class="empty-state"><p class="eyebrow">{data.status}</p><h1>{data.status === 410 ? 'This title has been removed.' : data.status === 503 ? 'Watch information is temporarily unavailable.' : 'This title could not be found.'}</h1><a class="button" href="/">Go home</a></section> : <article data-watch-page data-no-popunder>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={`/${title.type === 'tv' ? 'tv' : 'movie'}/${title.slug}/`}>{title.title}</a><span>/</span><span>Where to Watch</span></nav>
    <header class="watch-heading">{poster && <img src={poster} width="62" height="93" decoding="async" fetchpriority="high" alt={`${title.title} poster`} />}<div><p class="eyebrow">LEGAL WATCH OPTIONS</p><h1>Where to watch {title.title} in {name}</h1></div></header>
    <nav class="country-switcher" aria-label="Watch country">{supportedCountries.map(country => <a href={`?country=${country}`} aria-current={country === data.country ? 'page' : undefined}>{country === 'GB' ? 'UK' : country}</a>)}</nav>
    {data.providers.length ? <div class="provider-groups">{groups.map(group => {
      const rows = data.providers.filter(provider => group.values.includes(provider.offer_type));
      return rows.length > 0 && <section><h2>{group.name}</h2><ul>{rows.map(provider => <li><ProviderRow provider={provider} mediaBase={env.R2_PUBLIC_BASE} /></li>)}</ul></section>;
    })}</div> : <section class="empty-state"><h2>Not available to stream in {name} yet.</h2><p>Availability can change. Check another country below.</p></section>}
    <p class="provider-credit">Streaming data by JustWatch.</p>
    {data.availableCountries.length > 0 && <p class="available-countries">Available in: {data.availableCountries.map(country => <a href={`?country=${country}`}>{countryNames[country]}</a>)}</p>}
    <AdSlot pageType="watch" placement="top_300x250" /><AdSlot pageType="watch" placement="native" />
  </article>}
</Base>
