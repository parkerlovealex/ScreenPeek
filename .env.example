# ── Movie System — environment variables (copy to .env, NEVER commit .env) ──

# TMDb (sync only — server-side, never expose to the browser)
TMDB_READ_TOKEN=            # TMDb API Read Access Token (Bearer) — preferred
TMDB_API_KEY=               # …or the v3 API key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Cloudflare (used by sync via API + by wrangler locally)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=         # zone of the custom domain (cache purge on admin save + analytics meter)
CLOUDFLARE_API_TOKEN=       # scope per runtime: sync/deploy token in Actions; zone Cache Purge token in Worker
D1_DATABASE_ID=
KV_NAMESPACE_ID=
R2_BUCKET=posters
R2_ACCESS_KEY_ID=           # R2 S3 API credentials (sync poster uploads)
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=             # e.g. https://pub-xxxx.r2.dev  (custom domain later)

# Site
SITE_URL=https://example.workers.dev
DEPLOYMENT_ENV=preview       # production only on the real production deployment
SITE_NAME=ScreenPeek        # also stored in admin config; env is the bootstrap default
ADS_ENABLED=1               # keep 0 on previews and locally (placeholders only)

# Admin → GitHub "Run sync now" (fine-grained PAT: Actions read/write on this repo only)
CF_ACCESS_TEAM_DOMAIN=     # your-team.cloudflareaccess.com
CF_ACCESS_AUD=             # Access application audience (AUD)
GITHUB_REPO=parkerlovealex/ScreenPeek
GITHUB_ACTIONS_TOKEN=

# Adsterra Publisher API (Phase 2 Stats)
ADSTERRA_API_KEY=

# Telegram (optional — alerts + Phase 2 channel posting; leave empty to disable)
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=              # Karn's chat id (failure alerts)
TELEGRAM_CHANNEL_ID=        # site channel (Phase 2 auto-posts), e.g. @channelname

# OMDb (Phase 2, only if ratings_external is enabled in admin)
OMDB_API_KEY=
