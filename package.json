    "test:scaffold": "playwright test tests/scaffold.spec.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261109.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
