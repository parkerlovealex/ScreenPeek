{
  "name": "screenpeek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/tool.mjs astro dev --host 0.0.0.0 --ignore-lock",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/tool.mjs astro check",
    "preview": "node scripts/tool.mjs astro preview --host 0.0.0.0 --ignore-lock",
    "test:scaffold": "playwright test tests/scaffold.spec.ts",
    "db:schema": "node scripts/tool.mjs wrangler d1 execute movie-db --local --persist-to .wrangler/state --file=db/schema.sql",
    "db:seed": "node scripts/tool.mjs node scripts/seed-local.mjs",
    "db:setup": "npm run db:schema && npm run db:migrate && npm run db:seed",
    "db:remove-seed": "node scripts/tool.mjs node scripts/remove-seed.mjs",
    "test:database": "node --test tests/database.test.mjs",
    "test:tmdb": "node --test tests/tmdb.test.ts",
    "test:sync": "node --test tests/tmdb.test.ts tests/collectors.test.ts tests/transform.test.ts",
    "test:images": "node scripts/tool.mjs node --test tests/posters.test.ts tests/r2.test.ts tests/og.test.ts tests/colour.test.ts",
    "db:migrate": "node scripts/tool.mjs wrangler d1 migrations apply movie-db --local --persist-to .wrangler/state",
    "sync:run": "node scripts/tool.mjs node --use-env-proxy --env-file-if-exists=.env sync/sync.ts",
    "sync:fixture": "npm run sync:run -- --local --fixture",
    "test:sync-integration": "node scripts/tool.mjs node --test tests/d1.test.ts tests/persist.test.ts tests/sync-log.test.ts tests/notify.test.ts tests/local-bindings.test.ts tests/sync-engine.test.ts tests/seed-migrations.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:browser": "node scripts/tool.mjs playwright test",
    "test:catalogue": "node scripts/tool.mjs node --test tests/catalogue.test.ts tests/detail.test.ts tests/seasons.test.ts tests/people.test.ts tests/hubs.test.ts tests/trailer.test.ts tests/search.test.ts tests/watch.test.ts",
    "test:redirects": "node scripts/tool.mjs node --test tests/redirects.test.ts",
    "test:votes": "node scripts/tool.mjs node --test tests/votes.test.ts",
    "test:ads": "node scripts/tool.mjs node --test tests/ads.test.ts",
    "test:admin": "node scripts/tool.mjs node --test tests/admin.test.ts tests/admin-v2.test.ts tests/universal.test.ts tests/restore.test.ts tests/health.test.ts tests/metadata.test.ts",
    "test:trust": "node scripts/tool.mjs node --test tests/trust.test.ts",
    "test:seo": "node scripts/tool.mjs node --test tests/seo.test.ts",
    "test:deploy": "node --test tests/deploy.test.mjs",
    "deploy:prepare": "node scripts/tool.mjs node scripts/deploy-config.mjs",
    "deploy:dry-run": "node scripts/tool.mjs wrangler deploy --dry-run --config dist/server/wrangler.json --outdir .cache/deploy-dry-run",
    "deploy": "node scripts/tool.mjs node --use-env-proxy scripts/deploy.mjs",
    "test:static": "node scripts/tool.mjs node --test tests/static.test.ts",
    "check:performance": "node scripts/tool.mjs node scripts/performance.ts",
    "test:performance-gate": "node --test tests/performance-gate.test.mjs",
    "backup:run": "node scripts/tool.mjs node --use-env-proxy scripts/backup.ts",
    "backup:local": "npm run backup:run -- --local",
    "test:backup": "node --test tests/backup.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "astro": "7.4.7",
    "aws4fetch": "1.0.20",
    "micromark": "4.0.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261109.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "lighthouse": "13.6.0",
    "miniflare": "5.20261104.0-beta",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
