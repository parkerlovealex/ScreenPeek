{
  "name": "screenpeek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/tool.mjs astro dev --host 0.0.0.0 --ignore-lock",
